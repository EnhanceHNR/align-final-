generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  role               UserRole            @default(STAFF)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  visitNotes         VisitNote[]
  placedOrders       PurchaseOrder[]     @relation("PlacedOrders")
  receivedDeliveries Delivery[]          @relation("ReceivedDeliveries")
  staffAppointments  Appointment[]       @relation("StaffAppointments")
  consumedItems      ConsumptionRecord[] @relation("ConsumedItems")
  employeeProfile    EmployeeProfile?
  organizationId     String?
  organization       Organization?       @relation(fields: [organizationId], references: [id])
}

model Patient {
  id                 String              @id @default(cuid())
  fullName           String
  dateOfBirth        DateTime
  sex                String?
  address            String?
  phone              String?
  jmb                String
  employmentStatus   String?
  occupation         String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  email              String?
  notes              String?
  anamnesis          Anamnesis?
  appointments       Appointment[]
  invoices           Invoice[]
  treatments         Treatment[]
  treatmentPlans     TreatmentPlan[]
  visitNotes         VisitNote[]
  odontogramSurfaces OdontogramSurface[]
  labSubmissions     LabSubmission[]
  organizationId     String?
  organization       Organization?       @relation(fields: [organizationId], references: [id])

  @@unique([jmb, organizationId])
}

model Anamnesis {
  id                      String        @id @default(cuid())
  patientId               String        @unique
  allergiesFlag           Boolean       @default(false)
  allergiesDetails        String?
  anesthesiaHistoryFlag   Boolean       @default(false)
  anesthesiaComplications String?
  medicationsFlag         Boolean       @default(false)
  medicationsDetails      String?
  previousDiseases        String?
  currentDisease          String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  patient                 Patient       @relation(fields: [patientId], references: [id])
  organizationId          String?
  organization            Organization? @relation(fields: [organizationId], references: [id])
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  chairId        String? // Made optional initially to prevent migration errors on existing data
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(SCHEDULED)
  reason         String?
  cancelReason   String?
  doctorId       String?
  doctor         Doctor?           @relation(fields: [doctorId], references: [id])
  procedureId    String?
  procedure      Procedure?        @relation(fields: [procedureId], references: [id])
  teeth          String?           // To store selected teeth JSON array
  staffId        String?
  staff          User?             @relation(fields: [staffId], references: [id], name: "StaffAppointments")
  selfieUrl      String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  patient        Patient           @relation(fields: [patientId], references: [id])
  chair          Chair?            @relation(fields: [chairId], references: [id])
  visitNotes     VisitNote[]
  organizationId String?
  organization   Organization?     @relation(fields: [organizationId], references: [id])
}

model Treatment {
  id             String          @id @default(cuid())
  patientId      String
  treatmentDate  DateTime        @default(now())
  toothNumber    Int?
  diagnosis      String?
  therapy        String
  code           String
  status         TreatmentStatus @default(PLANNED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  invoiceItems   InvoiceItem[]
  patient        Patient         @relation(fields: [patientId], references: [id])
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id])
}

model VisitNote {
  id             String        @id @default(cuid())
  patientId      String
  content        String
  noteDate       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  appointmentId  String?
  userId         String
  appointment    Appointment?  @relation(fields: [appointmentId], references: [id])
  patient        Patient       @relation(fields: [patientId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model TreatmentPlan {
  id             String              @id @default(cuid())
  patientId      String
  title          String
  description    String?
  status         TreatmentPlanStatus @default(OPEN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  patient        Patient             @relation(fields: [patientId], references: [id])
  items          TreatmentPlanItem[]
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id])
}

model TreatmentPlanItem {
  id                   String                  @id @default(cuid())
  planId               String
  plannedToothNumber   Int?
  plannedProcedureCode String
  plannedTherapy       String
  status               TreatmentPlanItemStatus @default(PLANNED)
  plan                 TreatmentPlan           @relation(fields: [planId], references: [id])
  organizationId       String?
  organization         Organization?           @relation(fields: [organizationId], references: [id])
}

model Invoice {
  id             String        @id @default(cuid())
  patientId      String
  invoiceNumber  String        @unique
  subtotal       Float         @default(0)
  taxAmount      Float         @default(0)
  taxRate        Float         @default(0.17)
  totalAmount    Float
  status         InvoiceStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  patient        Patient       @relation(fields: [patientId], references: [id])
  items          InvoiceItem[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model InvoiceItem {
  id             String        @id @default(cuid())
  invoiceId      String
  treatmentId    String?
  serviceCode    String
  serviceName    String
  quantity       Int           @default(1)
  unitPrice      Float
  totalPrice     Float
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  treatment      Treatment?    @relation(fields: [treatmentId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model PriceListItem {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  price          Float
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Chair {
  id                 String        @id @default(cuid())
  name               String
  color              String        @default("#3b82f6")
  googleCalendarId   String? // ID of the connected Google Calendar
  googleAccessToken  String?       @db.Text
  googleRefreshToken String?       @db.Text
  googleSyncEnabled  Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  appointments       Appointment[]
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id])
}

enum UserRole {
  SUPERADMIN
  MASTER
  STAFF
}

enum AppointmentStatus {
  SCHEDULED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentStatus {
  PLANNED
  COMPLETED
  INVOICED
}

enum TreatmentPlanStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TreatmentPlanItemStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  PAID
  UNPAID
}

model OdontogramSurface {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  toothNumber    Int
  surface        String
  condition      String
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([patientId, toothNumber, surface])
}

model Lab {
  id             String           @id @default(cuid())
  name           String
  phone          String?
  services       Json?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  submissions    LabSubmission[]
  transactions   LabTransaction[]
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
}

model LabSubmission {
  id                     String  @id @default(cuid())
  type                   String
  senderName             String?
  receiverName           String?
  photoUrl               String?
  photoUrls              Json?
  deliveryPersonPhotoUrl String?
  senderSelfieUrl        String?
  item                   String
  subType                String?
  deliveryPerson         String?

  labId String
  lab   Lab    @relation(fields: [labId], references: [id])

  patientName String
  patientId   String?
  patient     Patient? @relation(fields: [patientId], references: [id])

  appointmentStatus String?
  appointmentDate   DateTime?

  servicePrice String?
  remarks      String?
  tat          String?

  linkedRecordId    String?
  linkedRecord      LabSubmission?  @relation("LinkedRecords", fields: [linkedRecordId], references: [id])
  subsequentRecords LabSubmission[] @relation("LinkedRecords")

  documents Json?

  isReturned Boolean? @default(false)

  approvalStatus  String?
  senderEmail     String?
  paymentStatus   String? @default("Pending")
  paymentProofUrl String?

  isAlertResolved Boolean? @default(false)
  editLogs        Json?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model LabTransaction {
  id             String        @id @default(cuid())
  labId          String
  lab            Lab           @relation(fields: [labId], references: [id])
  amount         Float
  type           String
  description    String
  photoUrl       String?
  submissionId   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model InstructionTemplate {
  id             String        @id @default(cuid())
  name           String
  text           String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model InventoryItem {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  company            String?
  brandName          String?
  genericName        String? // added
  tags               String[] // added
  itemCount          Int      @default(0)
  quantityValue      Float    @default(1)
  quantityUnit       String   @default("pcs") // ml, kg, gm, pcs, ltr
  dealerId           String?
  dealer             Dealer?  @relation(fields: [dealerId], references: [id])
  dealerAvailability Boolean  @default(true)
  costPerUnit        Float    @default(0)
  minQuantity        Int      @default(5)
  cases              Int      @default(0)
  category           String?
  status             String   @default("In Stock") // In Stock, Low Stock, Out of Stock
  imageUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  stockEntries       StockEntry[]
  purchaseOrders     PurchaseOrder[]
  consumptionRecords ConsumptionRecord[]
  organizationId     String?
  organization       Organization?       @relation(fields: [organizationId], references: [id])
}

model StockEntry {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantity        Int
  expiryDate      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
}

model PurchaseOrder {
  id               String        @id @default(cuid())
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity         Int
  dealerId         String
  dealer           Dealer        @relation(fields: [dealerId], references: [id])
  price            Float
  estimatedArrival DateTime?
  orderDate        DateTime      @default(now())
  status           String        @default("Pending Approval") // Pending Approval, Pending, Delivered, Rejected, Delayed
  paymentStatus    String        @default("Unpaid") // Unpaid, Pending Statement, Paid
  placedById       String?
  placedBy         User?         @relation("PlacedOrders", fields: [placedById], references: [id])
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  deliveries     Delivery[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Delivery {
  id                     String        @id @default(cuid())
  purchaseOrderId        String
  purchaseOrder          PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  itemPhotoUrl           String?
  receiverPhotoUrl       String?
  deliveryPersonPhotoUrl String?
  billPhotoUrl           String?
  receiverId             String?
  receiver               User?         @relation("ReceivedDeliveries", fields: [receiverId], references: [id])
  actualPrice            Float
  quantityReceived       Int
  deliveryDate           DateTime      @default(now())
  isApproved             Boolean       @default(false)
  comments               String?
  isPaid                 Boolean       @default(false)
  statementId            String?
  statement              Statement?    @relation(fields: [statementId], references: [id])
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id])
}

model Dealer {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  website       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
  statements     Statement[]
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id])
}

model Statement {
  id               String   @id @default(cuid())
  dealerId         String
  dealer           Dealer   @relation(fields: [dealerId], references: [id])
  startDate        DateTime
  endDate          DateTime
  totalAmount      Float
  status           String   @default("Pending") // Pending, Paid
  generatedDate    DateTime @default(now())
  paymentMode      String? // Card, Cheque, Cash, UPI, Other
  paymentReference String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deliveries     Delivery[]
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model ConsumptionRecord {
  id               String        @id @default(cuid())
  inventoryItemId  String
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityConsumed Int
  unit             String
  consumedById     String
  consumedBy       User          @relation("ConsumedItems", fields: [consumedById], references: [id])
  consumptionDate  DateTime      @default(now())
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
}

model LearningCategory {
  id             String             @id @default(cuid())
  name           String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  materials      LearningMaterial[]
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id])
}

model LearningMaterial {
  id             String           @id @default(cuid())
  categoryId     String
  category       LearningCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  url            String // URL of the image or video in Firebase Storage
  type           String           @default("IMAGE") // "IMAGE" or "VIDEO"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
}

model EmployeeProfile {
  id                         String    @id @default(cuid())
  userId                     String    @unique
  user                       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                       String
  department                 String?
  manager                    String?
  avatarUrl                  String?
  employeeType               String    @default("Employee") // Super Admin, Admin, Employee
  jobTitle                   String?
  phoneNumber                String?
  mobileNumber               String?
  address                    String?
  bloodGroup                 String?
  dateOfBirth                DateTime?
  emergencyContact           String?
  baseSalary                 Float     @default(0)
  weeklyOffs                 Json? // e.g., ["Saturday", "Sunday"]
  bufferTime                 Int       @default(0) // in minutes
  joiningDate                DateTime?
  paidLeaveBalance           Int       @default(0)
  sickLeaveBalance           Int       @default(0)
  doubleLateThresholdMinutes Int       @default(0)
  organizationName           String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  attendances    Attendance[]
  leaves         LeaveRequest[]
  shifts         ShiftSegment[]
  payrolls       PayrollRecord[]
  resignations   ResignationRequest[]
  rejoins        RejoinRequest[]
  documents      EmployeeDocument[]
  lateRequests   LateRequest[]
  earlyRequests  EarlyPunchOutRequest[]
  organizationId String?
  organization   Organization?          @relation(fields: [organizationId], references: [id])
}

model ShiftSegment {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  startTime         String // "HH:mm"
  endTime           String // "HH:mm"
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
}

model Attendance {
  id                  String          @id @default(cuid())
  employeeProfileId   String
  employeeProfile     EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  date                DateTime // Only Date part matters, can store as DateTime
  status              String          @default("Present") // Present, Late, Double Late, Absent, Holiday, Weekend, PaidLeave, UnpaidLeave
  lateMinutes         Int             @default(0)
  lateExcused         Boolean         @default(false)
  lateExcusedReason   String?
  isLateException     Boolean         @default(false)
  lateExceptionReason String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sessions       AttendanceSession[]
  organizationId String?
  organization   Organization?       @relation(fields: [organizationId], references: [id])
}

model AttendanceSession {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  clockInTime  DateTime
  clockInPhoto String?
  clockInLat   Float?
  clockInLng   Float?

  clockOutTime  DateTime?
  clockOutPhoto String?
  clockOutLat   Float?
  clockOutLng   Float?

  duration       String?
  remarks        String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model LeaveRequest {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  type              String // Paid Leave, Unpaid Leave, Sick Leave, Casual Leave
  startDate         DateTime
  endDate           DateTime
  days              Int
  dateOfApplying    DateTime        @default(now())
  reason            String?
  emergencyContact  String?
  status            String          @default("Pending") // Pending, Approved, Rejected
  reviewedBy        String?
  reviewedDate      DateTime?
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
}

model PayrollRecord {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  month             String
  year              Int
  baseSalary        Float
  netSalary         Float
  status            String          @default("Draft")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
}

model ResignationRequest {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  reason            String
  lastWorkingDay    DateTime
  status            String          @default("Pending")
  createdAt         DateTime        @default(now())
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
}

model RejoinRequest {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  reason            String
  requestedDate     DateTime
  status            String          @default("Pending")
  createdAt         DateTime        @default(now())
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
}

model EmployeeDocument {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  title             String
  fileUrl           String
  uploadedAt        DateTime        @default(now())
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
}

model Holiday {
  id             String        @id @default(cuid())
  name           String
  date           DateTime
  type           String        @default("Public")
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model LateRequest {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  date              DateTime
  reason            String
  status            String          @default("Pending")
  createdAt         DateTime        @default(now())
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
}

model EarlyPunchOutRequest {
  id                String          @id @default(cuid())
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  date              DateTime
  reason            String
  status            String          @default("Pending")
  createdAt         DateTime        @default(now())
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
}

model Organization {
  id                     String    @id @default(cuid())
  name                   String
  slug                   String    @unique
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  users                User[]
  patients             Patient[]
  appointments         Appointment[]
  treatments           Treatment[]
  visitNotes           VisitNote[]
  treatmentPlans       TreatmentPlan[]
  invoices             Invoice[]
  priceListItems       PriceListItem[]
  chairs               Chair[]
  odontogramSurfaces   OdontogramSurface[]
  labs                 Lab[]
  labSubmissions       LabSubmission[]
  labTransactions      LabTransaction[]
  instructionTemplates InstructionTemplate[]
  inventoryItems       InventoryItem[]
  stockEntries         StockEntry[]
  purchaseOrders       PurchaseOrder[]
  deliveries           Delivery[]
  dealers              Dealer[]
  statements           Statement[]
  consumptionRecords   ConsumptionRecord[]
  learningCategories   LearningCategory[]
  learningMaterials    LearningMaterial[]
  employeeProfiles     EmployeeProfile[]
  holidays             Holiday[]
  Anamnesis            Anamnesis[]
  TreatmentPlanItem    TreatmentPlanItem[]
  InvoiceItem          InvoiceItem[]
  ShiftSegment         ShiftSegment[]
  Attendance           Attendance[]
  AttendanceSession    AttendanceSession[]
  LeaveRequest         LeaveRequest[]
  PayrollRecord        PayrollRecord[]
  ResignationRequest   ResignationRequest[]
  RejoinRequest        RejoinRequest[]
  EmployeeDocument     EmployeeDocument[]
  LateRequest          LateRequest[]
  EarlyPunchOutRequest EarlyPunchOutRequest[]
  phone                  String?
  email                  String?
  address                String?
  orgType                String    @default("Clinic") // Clinic, Lab, Dealer
  workingHoursStart      String    @default("08:00")
  workingHoursEnd        String    @default("18:00")

  doctors        Doctor[]
  procedures     Procedure[]
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Doctor {
  id             String        @id @default(cuid())
  name           String
  color          String        @default("#10b981")
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
}

model Procedure {
  id             String        @id @default(cuid())
  name           String
  duration       Int           @default(30)
  color          String        @default("#6366f1")
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  appointments   Appointment[]
}
