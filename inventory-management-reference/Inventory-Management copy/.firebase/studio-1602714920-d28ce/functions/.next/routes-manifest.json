      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/orders/(?<nxtPid>[^/]+?)/verify(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/bills",
      "regex": "^/bills(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/bills(?:/)?$"
    },
    {
