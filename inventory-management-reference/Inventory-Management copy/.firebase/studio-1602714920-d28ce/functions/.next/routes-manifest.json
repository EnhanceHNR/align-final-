      "routeKeys": {},
      "namedRegex": "^/history(?:/)?$"
    },
    {
      "page": "/inventory",
      "regex": "^/inventory(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/inventory(?:/)?$"
    },
    {
      "page": "/inventory/add",
      "regex": "^/inventory/add(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/inventory/add(?:/)?$"
